{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gold-alert",
  "main": "worker/src/index.js",
  "account_id": "33b860554fbcb24db639ae34ad2ea919",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gold-alert-db",
      "database_id": "9da0baf0-88bb-4771-8be6-c01532699203"
    }
  ]
  // Static web UI is on Cloudflare Pages (alertdata.pages.dev).
  // /api is proxied by functions/api/[[path]].js → this Worker.
  // Deploy API: npm run deploy
  // Deploy web+proxy: npm run pages:deploy
  // Secrets (optional if first unlock bootstraps D1 api_token):
  //   npx wrangler secret put API_TOKEN
  //   npx wrangler secret put TELEGRAM_BOT_TOKEN
  //   npx wrangler secret put TELEGRAM_CHAT_ID
}
